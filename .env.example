# Image tag to run; pinned so migrations only run when you choose to update.
KUITIT_VERSION=0.1.0
# DSM service user with RW access to the data folder only (id -u / id -g on the NAS).
KUITIT_UID=1030
KUITIT_GID=100
KUITIT_DATA_DIR=/volume1/kuitit
# From DSM SSO Server > Application List. Authority is the issuer (well-known URL without the
# /.well-known/openid-configuration suffix).
OIDC_AUTHORITY=https://sso.example.com/webman/sso
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Email or subject per allowed user.
ALLOWED_USER_1=me@example.com
ALLOWED_USER_2=
ALLOWED_USER_3=
