# --- Required ---

# From DSM SSO Server > Application List. Authority is the issuer: the well-known URL without the
# /.well-known/openid-configuration suffix.
OIDC_AUTHORITY=https://sso.example.com/webman/sso
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# The app user (SSH: id <user>, e.g. uid=1031 gid=100). The app runs as this user and must be able to write
# the data folder: sudo chown -R <uid>:<gid> /volume1/kuitit/data
KUITIT_UID=
KUITIT_GID=

# --- Optional (defaults shown) ---

# Image tag. The compose.yaml attached to a release already defaults to that release.
#KUITIT_VERSION=latest
#KUITIT_DATA_DIR=/volume1/kuitit/data

# Who may sign in: `*` = every DSM account (each user only sees their own receipts), or list emails / subjects.
#ALLOWED_USER_1=*
#ALLOWED_USER_2=
#ALLOWED_USER_3=

# Telemetry dashboard (docker compose --profile dashboard up -d).
#OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
# Dashboard login token, e.g. openssl rand -hex 32. Empty: random, printed in its log.
#DASHBOARD_TOKEN=
