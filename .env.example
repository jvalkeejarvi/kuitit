# Image tag to run; pinned so migrations only run when you choose to update.
KUITIT_VERSION=0.1.0
# DSM service user with RW access to the data folder only (id -u / id -g on the NAS).
KUITIT_UID=1030
KUITIT_GID=100
KUITIT_DATA_DIR=/volume1/kuitit
# From DSM SSO Server > Application List. Authority is the issuer (well-known URL without the
# /.well-known/openid-configuration suffix).
OIDC_AUTHORITY=https://sso.example.com/webman/sso
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Who may sign in. `*` = every account SSO Server can authenticate, i.e. every DSM user on the NAS
# (each user only sees their own receipts). Or list emails / subjects one per variable instead.
ALLOWED_USER_1=*
ALLOWED_USER_2=
ALLOWED_USER_3=
# Optional telemetry dashboard (docker compose --profile dashboard up -d).
#OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
# Login token for the dashboard UI, e.g. openssl rand -hex 32. Empty: random, printed in its log.
DASHBOARD_TOKEN=
